---

// Components
import PurpleButton from './buttons/PurpleButton';

const sectionList:SectionData[] = [
  { title: '¿Qué es NANODERMA?', id: 'nanoderma-title' },
  { title: 'Casos de Éxito', id: 'casos-exito-title' },
];

type SectionData = {
  title: string;
  id: string;
}

---

<navbar class="py-3 bg-gray-800 flex justify-between md:justify-center items-center gap-4 px-4 fixed w-full z-10">

  <div class="hidden md:flex gap-4">

    {sectionList.map((section) => 
      <a href={`#${section.id}`} class="text-white px-4 py-2 rounded-full hover:bg-gray-700">{section.title}</a>)}

  </div>

  <span class="text-white md:hidden">NANODERMA</span>

  <a href="#contact-me-title">
    <PurpleButton>Contáctame</PurpleButton>
  </a>

</navbar>